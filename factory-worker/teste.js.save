import fs from "fs";
import path from "path";

const raiz = "/workspaces/rh-prospera-hub/src";

function procurarArquivos(dir, resultados = []) {
  const itens = fs.readdirSync(dir);

  for (const item of itens) {
    const completo = path.join(dir, item);
    const stat = fs.statSync(completo);

    if (stat.isDirectory()) {
      procurarArquivos(completo, resultados);
    } else if (
      item.endsWith(".tsx") ||
      item.endsWith(".ts")
    ) {
      const conteudo = fs.readFileSync(completo, "utf8");

      if (
        conteudo.includes("Dashboard") ||
        conteudo.includes("dashboard") ||
        conteudo.includes("TOTAL FUNCIONÁRIOS") ||
        conteudo.includes("Funcionários") ||
        conteudo.includes("Proventos") ||
        conteudo.includes("Descontos")
      ) {
        resultados.push(completo);
      }
    }
  }

  return resultados;
}

const encontrados = procurarArquivos(raiz);

console.log("ARQUIVOS ENCONTRADOS:");
console.log(encontrados);
cat > teste.js << 'EOF'
