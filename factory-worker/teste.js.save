  type: "project_update",
  status: "pending",

  payload: {
    projectRoot: "/workspaces/rh-prospera-hub",

    action: "update_dashboard",

    files: [
      "src/pages/DashboardPage.tsx"
    ],

    objective:
      "Criar versão mobile moderna do dashboard mantendo layout desktop intacto"
  }
}
]);

console.log(data || error);
EOF

